# FootIntel Backend Configuration Example
# Copy to .env (or export in environment) and adjust for your deployment origin.

# Comma-separated list of allowed browser origins for CORS (set to your HTTPS frontend origin in production)
FOOTINTEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides for DuckDB database and Phase 2 analysis outputs directory
# FOOTINTEL_DB_PATH=/path/to/footintel.duckdb
# FOOTINTEL_OUTPUT_DIR=/path/to/analysis_outputs

# Optional DuckDB resource caps & request concurrency bounds (recommended on 512 MB hosts)
# FOOTINTEL_DUCKDB_MEMORY_LIMIT=192MB
# FOOTINTEL_DUCKDB_CSV_MEMORY_LIMIT=64MB
# FOOTINTEL_DUCKDB_THREADS=1
# FOOTINTEL_DB_MAX_CONCURRENCY=4
# FOOTINTEL_CSV_MAX_CONCURRENCY=2

# Production startup artifact hydration from GitHub Releases (leave unset for local dev no-op)
# Set FOOTINTEL_ENV=production (automatically enforced when RENDER=true) to fail fast if missing.
# FOOTINTEL_ENV=production
# FOOTINTEL_DB_ASSET_URL=https://github.com/kushagra3009/FootIntel/releases/download/<tag>/footintel.duckdb.gz
# FOOTINTEL_DB_SHA256=<64-char-sha256-of-release-asset>
# FOOTINTEL_OUTPUTS_ASSET_URL=https://github.com/kushagra3009/FootIntel/releases/download/<tag>/analysis_outputs.tar.gz
# FOOTINTEL_OUTPUTS_SHA256=<64-char-sha256-of-release-asset>
